{
  "name": "castledecks-preparation",
  "services": {
    "static": {
      "image": "nginx:1.30.5-alpine3.24",
      "ports": [
        "127.0.0.1:8090:80"
      ],
      "volumes": [
        "${STATIC_DIST:?Set absolute path to an accepted site/dist}:/usr/share/nginx/html:ro",
        "./nginx/off.conf:/etc/nginx/conf.d/default.conf:ro"
      ],
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      }
    },
    "accounts": {
      "profiles": [
        "accounts"
      ],
      "build": {
        "context": "..",
        "dockerfile": "deploy/Dockerfile"
      },
      "environment": {
        "PUBLIC_ORIGIN": "https://castledecks.jaydensrealm.com",
        "ENABLE_ACCOUNTS": "${ENABLE_ACCOUNTS:-false}",
        "ENABLE_PRIVATE_ROOMS": "false",
        "GOOGLE_CLIENT_ID_FILE": "/run/secrets/google_client_id",
        "GOOGLE_CLIENT_SECRET_FILE": "/run/secrets/google_client_secret",
        "TRUSTED_PROXY_CIDRS": "",
        "DELETION_JOURNAL_PATH": "/journal/deletions.sqlite",
        "RECOVERY_POLICY_FILE": "/run/config/recovery-policy.json"
      },
      "secrets": [
        "google_client_id",
        "google_client_secret"
      ],
      "volumes": [
        "account_data:/data",
        "deletion_data:/journal",
        "${RECOVERY_POLICY_PATH:-./unconfigured/recovery-policy.json}:/run/config/recovery-policy.json:ro"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:size=16m,mode=1777"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "pids_limit": 64,
      "mem_limit": "256m",
      "cpus": 1,
      "stop_grace_period": "15s",
      "healthcheck": {
        "test": [
          "CMD",
          "/app/healthcheck"
        ],
        "interval": "30s",
        "timeout": "4s",
        "retries": 3,
        "start_period": "20s"
      },
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      }
    }
  },
  "secrets": {
    "google_client_id": {
      "file": "${GOOGLE_CLIENT_ID_FILE_PATH:-./unconfigured/client-id}"
    },
    "google_client_secret": {
      "file": "${GOOGLE_CLIENT_SECRET_FILE_PATH:-./unconfigured/client-secret}"
    }
  },
  "volumes": {
    "account_data": {},
    "deletion_data": {}
  }
}
