# EXAMPLE ONLY. No real credentials belong in this repository.
STATIC_DIST=/absolute/path/to/accepted/site/dist
ENABLE_ACCOUNTS=false
# Approved secret mounts must be readable by numeric container UID 10001.
GOOGLE_CLIENT_ID_FILE_PATH=/approved/secret/path/google-client-id
GOOGLE_CLIENT_SECRET_FILE_PATH=/approved/secret/path/google-client-secret

RECOVERY_POLICY_PATH=/approved/non-secret/recovery-policy.json
